# GramSetu server configuration
# Copy these values into your shell environment or your deployment secret manager.

# Stage 1 AI
# Leave blank/unset to use the free local rule-based fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Admin account(s), comma-separated 10-digit Indian phone numbers.
GRAMSETU_ADMIN_PHONE=

# OTP mode used by the existing authentication flow.
# development = return the OTP for local testing
# production  = require SMS delivery
GRAMSETU_ENV=development

# Existing SMS production hook, if used.
GRAMSETU_SMS_WEBHOOK_URL=
